# Copy into environment variables; do not commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
DB_PATH=./data/opensuite.sqlite
# Development only, localhost-only: allow first-time organizations to sign up.
DEV_ALLOW_REGISTRATION=1
# Optional configured Nextcloud server (one explicitly-scoped tenant only).
# NEXTCLOUD_BASE_URL=https://cloud.example.com
# NEXTCLOUD_TENANT_ID=<tenant UUID>
# NEXTCLOUD_USERNAME=<dedicated account>
# NEXTCLOUD_APP_PASSWORD=<app-password>

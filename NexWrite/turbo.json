{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@nexwrite/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false,
      "passThroughEnv": ["RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "CARGO_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "all_proxy", "no_proxy", "SSL_CERT_FILE", "SSL_CERT_DIR", "CARGO_HTTP_CAINFO", "NODE_EXTRA_CA_CERTS"]
    },
    "check": { "dependsOn": ["^check"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] }
  }
}

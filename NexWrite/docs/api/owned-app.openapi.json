{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "NexWrite owned application API",
    "version": "0.2.0-preview.1",
    "description": "Runtime-configured local-first writing API. DTO bindings do not implement an HTTP SDK. Requests and responses reject unknown fields, nonfinite numbers and unpaired UTF-16 surrogates. Enforce x-utf8-max-bytes before processing and before returning provider output; ordinary JSON Schema string length counts Unicode code points, not UTF-8 bytes. Limit the complete HTTP JSON body to 2 MiB independently. Provider keys and upstream URLs are operator configuration only. /health and /v1/capabilities are public safe discovery. Analysis and rewrite require a runtime bearer token when auth_required is true; nonloopback listeners must fail closed without configured authentication."
  },
  "x-spdx": "LicenseRef-NexWrite-Proprietary",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "description": "Liveness only; never return credentials or source.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "description": "Report actual engine availability and rule count. Initial locales, formats and tasks are fixed. Providers expose only configured profile ids and server-selected model allowlists. accounts and cloud_docs remain false.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "operationId": "analyze",
        "description": "Explicit request to the canonical Rust engine. Never upload automatically after a local-engine failure. UTF-8 input is capped at 1 MiB. The response directly reuses the existing AnalysisResult registry and its Suggestion/Span references.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../packages/protocol/schema/analysis.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "504": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ]
      }
    },
    "/v1/rewrite": {
      "post": {
        "operationId": "rewrite",
        "description": "Explicit cloud request only after destination consent. Input is capped at 32768 UTF-8 bytes; replacement at 65536. No silent provider fallback. Cancellation aborts downstream work, timeout is bounded to 30 seconds and at most one schema-repair retry shares that request budget. 400 invalid input; 401 invalid access token; 403 absent consent; 409 version conflict where implemented; 413 byte/body cap; 422 unsupported locale/task/preset/provider/model; 429 rate limit; 502 invalid/upstream response; 503 unavailable provider; 504 timeout.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "502": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "504": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewriteRequest"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiLocale": {
        "type": "string",
        "enum": [
          "en-US"
        ],
        "x-unicode-scalar-string": true
      },
      "AiTask": {
        "type": "string",
        "enum": [
          "rewrite",
          "summarize",
          "compose"
        ],
        "x-unicode-scalar-string": true
      },
      "AiPreset": {
        "type": "string",
        "enum": [
          "proofread",
          "clearer",
          "shorten",
          "expand",
          "formal",
          "friendly",
          "direct"
        ],
        "x-unicode-scalar-string": true
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "x-unicode-scalar-string": true
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-unicode-scalar-string": true
          }
        }
      },
      "EngineCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "available",
          "rule_count",
          "locales",
          "input_formats"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "rule_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "locales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiLocale"
            },
            "const": [
              "en-US"
            ]
          },
          "input_formats": {
            "type": "array",
            "items": {
              "$ref": "../../packages/protocol/schema/analysis.schema.json#/$defs/InputFormat"
            },
            "const": [
              "plain",
              "markdown"
            ]
          }
        }
      },
      "ProviderProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "configured",
          "models"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "x-unicode-scalar-string": true
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "x-unicode-scalar-string": true
          },
          "configured": {
            "type": "boolean"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "x-unicode-scalar-string": true
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "version",
          "engine",
          "tasks",
          "providers",
          "accounts",
          "cloud_docs",
          "auth_required"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-unicode-scalar-string": true
          },
          "engine": {
            "$ref": "#/components/schemas/EngineCapabilities"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiTask"
            },
            "const": [
              "rewrite",
              "summarize",
              "compose"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderProfile"
            }
          },
          "accounts": {
            "type": "boolean",
            "const": false
          },
          "cloud_docs": {
            "type": "boolean",
            "const": false
          },
          "auth_required": {
            "type": "boolean"
          }
        }
      },
      "AnalyzeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "doc_version",
          "locale",
          "input_format"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1048576,
            "x-utf8-max-bytes": 1048576,
            "x-unicode-scalar-string": true
          },
          "doc_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "locale": {
            "$ref": "#/components/schemas/ApiLocale"
          },
          "input_format": {
            "$ref": "../../packages/protocol/schema/analysis.schema.json#/$defs/InputFormat"
          }
        }
      },
      "RewriteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "doc_version",
          "locale",
          "task",
          "preset",
          "provider",
          "model",
          "cloud_consent"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 32768,
            "x-utf8-max-bytes": 32768,
            "x-unicode-scalar-string": true,
            "minLength": 1,
            "pattern": "\\S"
          },
          "doc_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "locale": {
            "$ref": "#/components/schemas/ApiLocale"
          },
          "task": {
            "$ref": "#/components/schemas/AiTask"
          },
          "preset": {
            "$ref": "#/components/schemas/AiPreset"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "x-unicode-scalar-string": true
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "x-unicode-scalar-string": true
          },
          "cloud_consent": {
            "type": "boolean",
            "const": true
          }
        },
        "description": "The provider identifies a server-configured profile, never an arbitrary upstream URL. Initial default profiles are openai and gemini. The model must occur in that profile's current capabilities allowlist. All tasks require a nonblank source or compose brief. Summarize and compose accept only the clearer preset.",
        "allOf": [
          {
            "if": {
              "properties": {
                "task": {
                  "enum": [
                    "summarize",
                    "compose"
                  ]
                }
              },
              "required": [
                "task"
              ]
            },
            "then": {
              "properties": {
                "preset": {
                  "const": "clearer"
                }
              }
            }
          }
        ]
      },
      "AiResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "doc_version",
          "provider",
          "model",
          "task",
          "preset",
          "original",
          "replacement",
          "warnings"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "x-unicode-scalar-string": true
          },
          "doc_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "x-unicode-scalar-string": true
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "x-unicode-scalar-string": true
          },
          "task": {
            "$ref": "#/components/schemas/AiTask"
          },
          "preset": {
            "$ref": "#/components/schemas/AiPreset"
          },
          "original": {
            "type": "string",
            "maxLength": 32768,
            "x-utf8-max-bytes": 32768,
            "x-unicode-scalar-string": true
          },
          "replacement": {
            "type": "string",
            "maxLength": 65536,
            "x-utf8-max-bytes": 65536,
            "x-unicode-scalar-string": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512,
              "x-unicode-scalar-string": true
            },
            "maxItems": 64
          }
        },
        "description": "A proposed plain-text replacement, not executable HTML, tools or actions. original must equal the exact request text; request identity, document version, provider, model, task and preset must match the request before a client enables Apply."
      },
      "ApiProblem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-unicode-scalar-string": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "x-unicode-scalar-string": true
          },
          "status": {
            "type": "integer",
            "enum": [
              400,
              401,
              403,
              409,
              413,
              422,
              429,
              502,
              503,
              504
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "x-unicode-scalar-string": true
          },
          "request_id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "x-unicode-scalar-string": true
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "description": "Safe error metadata only. Never include source text, tokens, upstream payloads or stack traces. retry_after_seconds is optional and omitted when unavailable."
      }
    },
    "responses": {
      "Problem": {
        "description": "Safe problem response; see status mapping and stable code.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Runtime operator-issued access token; never bundled in a client. Required for protected operations when capabilities.auth_required is true. An empty security alternative supports the loopback-only unauthenticated personal profile."
      }
    }
  }
}

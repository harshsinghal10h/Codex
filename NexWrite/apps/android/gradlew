#!/usr/bin/env bash
# SPDX-License-Identifier: LicenseRef-NexWrite-Proprietary
set -euo pipefail
android_project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
nexwrite_root=$(cd -- "$android_project/../.." && pwd)
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$nexwrite_root/target/android-gradle-home}"
gradle_version=9.3.0
gradle_sha=0d585f69da091fc5b2beced877feab55a3064d43b8a1d46aeb07996b0915e0e0
gradle_cache="$GRADLE_USER_HOME/verified-distributions"
gradle_executable="$gradle_cache/gradle-$gradle_version/bin/gradle"
if ! test -x "$gradle_executable"; then
  mkdir -p "$gradle_cache"
  archive="$gradle_cache/gradle-$gradle_version-bin.zip"
  curl --fail --location --silent --show-error --retry 3 \
    "https://services.gradle.org/distributions/gradle-$gradle_version-bin.zip" --output "$archive"
  python3 - "$archive" "$gradle_sha" <<'PY'
import hashlib, pathlib, sys
path = pathlib.Path(sys.argv[1])
if hashlib.sha256(path.read_bytes()).hexdigest() != sys.argv[2]:
    raise SystemExit('Gradle distribution SHA-256 does not match the reviewed pin')
PY
  unzip -q "$archive" -d "$gradle_cache"
fi
exec "$gradle_executable" --project-dir "$android_project" "$@"

